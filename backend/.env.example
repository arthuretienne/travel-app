# ============================================
# Skusku Backend — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Database (Neon PostgreSQL) — base applicative (Prisma)
DATABASE_URL="postgresql://user:password@host:5432/database"

# Supabase — couche vectorielle (pgvector) du moteur de recommandation.
# REQUIS : sans ces vars, recommendationEngine.js lève au premier appel.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Voyage AI — embeddings (modèle voyage-large-2, 1536 dimensions).
# REQUIS pour générer le DNA utilisateur et les vecteurs destinations.
VOYAGE_AI_API_KEY="pa-..."

# Clerk Authentication
CLERK_SECRET_KEY="sk_live_..."
# Signing secret of the Clerk webhook endpoint (Dashboard → Webhooks). REQUIRED
# to accept POST /api/users/sync — requests are rejected without a valid Svix signature.
CLERK_WEBHOOK_SECRET="whsec_..."

# Anthropic (Claude AI) — enrichissement / "raison" uniquement, ne choisit pas la destination
ANTHROPIC_API_KEY="sk-ant-..."

# Amadeus (référencé par env.js — vols ; optionnel si non utilisé)
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""

# Booking.com via RapidAPI
BOOKING_API_KEY="your_rapidapi_key"

# Pexels (Photos)
PEXELS_API_KEY="your_pexels_key"

# Resend (Email)
RESEND_API_KEY="re_..."
EMAIL_FROM="Skusku <hello@skusku.life>"

# Stripe (Billing)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PRICE_ID_EXPLORER="price_..."
STRIPE_PRICE_ID_WANDERER="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Google Calendar OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="https://your-backend.onrender.com/api/calendar/oauth/callback"

# Upstash Redis Cache (optional — falls back to in-memory)
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# Web Push Notifications (VAPID)
# Generate keys: npx web-push generate-vapid-keys
# ⚠️ NEVER commit real keys. The previously committed pair was leaked and MUST
# be rotated (regenerate + update Render). Existing subscriptions will need to
# re-subscribe after rotation.
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_EMAIL="mailto:hello@skusku.life"

# Cron Job Secret (any random string — set same in Render Cron Job headers)
CRON_SECRET="generate_with: openssl rand -hex 32"

# Feature Flags
BETA_MODE=true  # Set to false in production to activate search limits
NODE_ENV=development
PORT=3001

# Travelpayouts affiliate (commission on hotel booking redirects)
# Get these from your Travelpayouts dashboard. Without TP_MARKER set,
# booking links still work but earn no commission.
TP_MARKER=
TP_CAMPAIGN=
TP_P_BOOKING=
