// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// USER & AUTH
// ========================================

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  searches      Search[]
  savedTrips    SavedTrip[]
  preferences   UserPreferences?
  subscription  Subscription?
  optimalPeriods OptimalPeriod[]

  // Collaborative trips
  createdTrips     CollaborativeTrip[] @relation("CreatedTrips")
  tripMemberships  TripMember[]
  invitationsSent  TripInvitation[]
  proposedDestinations ProposedDestination[]
  votes            TripVote[]
  messages         TripMessage[]
  friendships      Friendship[] @relation("UserFriendships")
  friendOf         Friendship[] @relation("FriendOf")
  priceAlerts      PriceAlert[]
  pushSubscriptions PushSubscription[]
  expensesPaid     TripExpense[] @relation("ExpensesPaid")
}

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Onboarding metadata
  onboardingCompleted Boolean @default(false)
  onboardingType      String? // "short" or "long"

  // Partie 1: Style & Objectif du voyage
  whyTravel           String? // Raison de voyager
  mainGoal            String? // But principal
  globalStyle         String? // Style global
  riskTolerance       Int?    // 0-100 slider
  originalityAppetite Int?    // 0-100 slider
  introvertExtrovert  Int?    // 0-100 slider (0=introverti, 100=extraverti)
  plannerImprovisator String? // "planner" | "improvisator" | "balanced"
  modernComfortAuth   Int?    // 0-100 slider (0=confort moderne, 100=authenticité)

  // Partie 2: Activités préférées
  topActivities       String[] // Top 3-5 activités

  // Partie 3: Rythme et confort
  idealRhythm         String? // Rythme idéal
  accommodationPref   String? // Préférence hébergement
  comfortAuthSlider   Int?    // 0-100 slider
  stayOrMove          String? // "same_place" | "itinerant" | "roadtrip"
  transportModes      String[] // Moyens de transport acceptés
  transportComfort    String? // Niveau de confort transport
  maxTransportHours   Int?    // Durée max transport
  materialComfort     Int?    // 0-100 importance confort matériel

  // Partie 4: Contraintes pratiques
  visaPreference      String? // Préférence visa
  avoidCountries      String[] // Pays à éviter
  mobilityNeeds       String? // PMR, etc
  mobilityDetails     String? // Détails sur les besoins de mobilité
  securityImportance  Int?    // 0-100
  crowdTolerance      Int?    // 0-100
  ecoSensitivity      Int?    // 0-100
  culturalAdaptability Int?   // 0-100
  climateSensitivity  String? // Sensibilité climatique

  // Partie 5: Dispos et patterns
  tripsPerYear        Int?    // Fréquence voyages/an
  departureFlexibility String? // weekend, weekday, flexible
  calendarConnected   Boolean @default(false)
  calendarType        String? // google, outlook, manual
  calendarAccessToken String? // OAuth access token (encrypted in production)
  calendarRefreshToken String? // OAuth refresh token (encrypted in production)
  calendarTokenExpiry DateTime? // Token expiry timestamp
  annualLeaveDays     Int?    // Congés annuels
  takenLeaveDays      Int?    // Congés déjà pris
  avgTripDuration     Int?    // Durée moyenne souhaitée (jours)
  preferredAirports   String[] // Villes de départ préférées

  // Legacy fields (keep for backward compatibility)
  budget            Int?
  style             String?
  preferredMonths   String[]
  activities        String[]
  maxFlightHours    Int?
  destinationPref   String?

  // New onboarding fields (OnboardingNew component)
  personality         String? // "routard" | "explorateur" | "confort" | "luxe"
  refusedTransports   String[] // Inverse logic: transports user REFUSES (empty = all accepted)
  professionalStatus  String? // "salarié" | "indépendant" | "étudiant" | "retraité" | "autre"
  idealDuration       String? // "weekend" | "1-semaine" | "2-semaines" | "3-semaines" | "flexible"

  // Email preferences
  digestOptOut        Boolean @default(false) // Opt-out from weekly digest emails

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========================================
// SEARCHES & RECOMMENDATIONS
// ========================================

model Search {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  searchParams Json

  createdAt DateTime @default(now())

  recommendations Recommendation[]

  @@index([userId])
  @@index([createdAt])
}

model Recommendation {
  id       String @id @default(cuid())
  searchId String
  search   Search @relation(fields: [searchId], references: [id], onDelete: Cascade)

  city        String
  country     String
  iataCode    String

  startDate   DateTime
  endDate     DateTime
  duration    Int

  flightPrice Float
  hotelPrice  Float
  totalPrice  Float
  currency    String @default("EUR")

  score         Float
  matchReason   String
  seasonReason  String

  photoUrl      String?
  photoCredit   String?

  fullData    Json

  createdAt   DateTime @default(now())
}

// ========================================
// ALGORITHM ANALYSIS (track destination diversity)
// ========================================

model AlgorithmResult {
  id        String   @id @default(cuid())

  // User context
  userId    String?

  // What Claude suggested
  claudeDestinations  String[] // Raw list from Claude AI

  // What was actually shown to user (after flight/hotel filtering)
  finalDestinations   String[]

  // User profile summary (for analysis)
  userProfile         Json

  // Performance metrics
  claudeLatencyMs     Int?
  totalLatencyMs      Int?

  // Scenario
  scenario            String // "WITH_DESTINATION" or "WITHOUT_DESTINATION"
  origin              String
  budget              Int
  duration            Int

  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ========================================
// SAVED TRIPS
// ========================================

model SavedTrip {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  city        String
  country     String
  startDate   DateTime
  endDate     DateTime

  status      String @default("wishlist")

  notes       String?

  tripData    Json

  // Link to collaborative trip if converted
  collaborativeTripId String?
  collaborativeTrip   CollaborativeTrip? @relation(fields: [collaborativeTripId], references: [id], onDelete: SetNull)

  // Can be proposed in group trips
  proposedIn ProposedDestination[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ========================================
// OPTIMAL TRAVEL PERIODS (AI-GENERATED)
// ========================================

model OptimalPeriod {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Period type
  type String // "short" or "long"

  // Date range
  startDate DateTime
  endDate   DateTime
  duration  Int

  // Recommendation details
  title              String
  reason             String
  savings            String // e.g., "30%"
  confidence         Int    // 0-100
  priceMultiplier    Float  // e.g., 0.70 for 30% savings
  leaveDaysRequired  Int
  canAfford          Boolean @default(true)

  // Additional metadata
  season       String?   // spring, summer, autumn, winter
  events       String[]  // Cultural events during this period
  tags         String[]  // prix-bas, météo-idéale, etc.
  weatherScore Int?      // 0-100

  // Timestamps
  generatedAt DateTime @default(now())
  expiresAt   DateTime // When this recommendation becomes stale

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
  @@index([userId, expiresAt])
}

// ========================================
// COLLABORATIVE TRIPS
// ========================================

model CollaborativeTrip {
  id        String   @id @default(cuid())
  creatorId String
  creator   User     @relation("CreatedTrips", fields: [creatorId], references: [id], onDelete: Cascade)

  // Trip metadata
  name           String
  coverImageUrl  String?

  // Origin - converted from solo trip or created from scratch
  originSavedTripId String?
  convertedSavedTrips SavedTrip[]

  // Status workflow
  status String // "draft" | "inviting" | "voting" | "destination_selected" | "booking" | "confirmed" | "cancelled"

  // Voting deadline
  voteDeadline DateTime?

  // Final validated data (after vote)
  finalDestination   Json?
  finalStartDate     DateTime?
  finalEndDate       DateTime?
  finalDuration      Int?
  finalBudgetPerPerson Float?

  // Settings
  maxMembers      Int @default(8)
  requireAllVotes Boolean @default(false)

  // Relations
  members       TripMember[]
  invitations   TripInvitation[]
  votes         TripVote[]
  messages      TripMessage[]
  proposedTrips ProposedDestination[]
  expenses      TripExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
}

model TripMember {
  id     String @id @default(cuid())
  tripId String
  trip   CollaborativeTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  userId String?
  user   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Guest info (if no account)
  guestEmail   String?
  guestName    String?
  sessionToken String? @unique // Token for guest WebSocket authentication

  // Role
  role String // "organizer" | "member" | "guest"

  // Booking status
  hasBookedFlight  Boolean @default(false)
  hasBookedHotel   Boolean @default(false)
  bookingConfirmed Boolean @default(false)

  // Preferences for matching
  availableDates   Json?
  budgetRange      Json?
  preferredActivities String[]

  joinedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@unique([tripId, userId])
  @@unique([tripId, guestEmail])
  @@index([tripId])
  @@index([userId])
}

model TripInvitation {
  id     String @id @default(cuid())
  tripId String
  trip   CollaborativeTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // Invitee
  email      String
  invitedBy  String
  inviter    User   @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  // Secure token
  token  String @unique @default(cuid())

  // Status
  status String // "pending" | "accepted" | "declined" | "expired"

  // Metadata
  message String?
  expiresAt DateTime
  respondedAt DateTime?

  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([email])
  @@index([token])
}

model ProposedDestination {
  id     String @id @default(cuid())
  tripId String
  trip   CollaborativeTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // Link to saved trip
  savedTripId String?
  savedTrip   SavedTrip? @relation(fields: [savedTripId], references: [id], onDelete: SetNull)

  // Proposed by
  proposedBy String
  proposer   User   @relation(fields: [proposedBy], references: [id], onDelete: Cascade)

  // Destination data
  city    String
  country String

  startDate DateTime
  endDate   DateTime
  duration  Int

  // Pricing
  estimatedCostPerPerson Float
  currency String @default("EUR")

  // Match score with group
  groupMatchScore Float?

  // Full trip data
  tripData Json

  // Votes for this destination
  votes TripVote[]

  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([proposedBy])
}

model TripVote {
  id     String @id @default(cuid())
  tripId String
  trip   CollaborativeTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  userId String
  voter  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Vote ranking
  destinationId String
  destination   ProposedDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  rank Int // 1 = preferred, 2 = 2nd choice, etc.

  // Vote details
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, userId, destinationId])
  @@index([tripId])
  @@index([userId])
}

model TripMessage {
  id     String @id @default(cuid())
  tripId String
  trip   CollaborativeTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // Guest author
  guestName String?

  content String
  type    String @default("message") // "message" | "system" | "vote_update"

  createdAt DateTime @default(now())

  @@index([tripId, createdAt])
}

// ========================================
// FRIENDS SYSTEM
// ========================================

model Friendship {
  id String @id @default(cuid())

  userId   String
  user     User   @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)

  friendId String
  friend   User   @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  status String // "pending" | "accepted" | "declined" | "blocked"

  requestedBy String // userId who initiated

  createdAt DateTime @default(now())
  acceptedAt DateTime?

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

// ========================================
// SUBSCRIPTIONS & BILLING
// ========================================

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stripe data
  stripeCustomerId       String? @unique
  stripeSubscriptionId   String? @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  // Plan details
  plan   String @default("FREE") // "FREE", "EXPLORER", "WANDERER"
  status String @default("active") // "active", "canceled", "past_due", "trialing"

  // Trip Pass — one-time 7-day unlimited access, independent of `plan`.
  // When set and in the future, the user has TRIP_PASS-level entitlements.
  tripPassExpiresAt DateTime?

  // Usage tracking
  searchesThisMonth Int @default(0)
  groupTripsCreated Int @default(0)

  // Billing
  lastBillingDate DateTime?
  nextBillingDate DateTime?
  cancelAtPeriodEnd Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

// ========================================
// PRICE ALERTS
// ========================================

model PriceAlert {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Trip details
  savedTripId String?
  destination String   // City name
  country     String?
  origin      String   // Departure city

  // Travel dates
  departureDate DateTime
  returnDate    DateTime
  duration      Int

  // Price tracking
  initialPrice     Float    // Price when alert was created
  targetPrice      Float    // Alert triggers when price drops below this
  currentPrice     Float?   // Last checked price
  lowestPrice      Float?   // Lowest price seen
  priceHistory     Json     @default("[]") // Array of { date, price }

  // Alert settings
  alertType  String @default("flight") // "flight", "hotel", "both"
  isActive   Boolean @default(true)
  frequency  String @default("daily") // "daily", "weekly"

  // Notification tracking
  lastCheckedAt    DateTime?
  lastNotifiedAt   DateTime?
  notificationsSent Int @default(0)

  // Status
  status String @default("active") // "active", "paused", "triggered", "expired"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([isActive, lastCheckedAt])
}

// ========================================
// PUSH NOTIFICATIONS
// ========================================

model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String
  p256dh   String
  auth     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@index([userId])
}

// ========================================
// EXPENSE SPLITTING (Tricount-style)
// ========================================

model TripExpense {
  id     String @id @default(cuid())
  tripId String
  trip   CollaborativeTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // Who paid
  paidById String
  paidBy   User   @relation("ExpensesPaid", fields: [paidById], references: [id], onDelete: Cascade)

  // Expense details
  description String
  amount      Float
  currency    String @default("EUR")
  category    String @default("other") // "food", "transport", "accommodation", "activity", "shopping", "other"
  date        DateTime @default(now())

  // Split configuration
  splitType   String @default("equal") // "equal", "custom", "percentage"
  splitAmong  Json   // Array of { userId, amount?, percentage? }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([paidById])
}
